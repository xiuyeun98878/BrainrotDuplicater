	if clicked then return end
	clicked = true

	GenerateButton.Text = "GENERATING..."
	GenerateButton.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
	GenerateButton.AutoButtonColor = false

	for i = 20, 1, -1 do
		LoadingText.Text = "Generating brainrots... " .. i .. "s"
		task.wait(1)
	end

	LoadingText.Text = "Done!"
	task.wait(0.5)

	ScreenGui:Destroy()
end)
